; OpenDM installer - Inno Setup 7.x
; Build order:  python build.py   ->   copy ffmpeg.exe into .\ffmpeg\   ->   compile this file (installer\OpenDM.iss)
#define AppName    "OpenDM"
#include "branding.iss"   ; generated by build.py from the BRAND block (publisher, URLs, version)
#define AppExe     "OpenDM.exe"

[Setup]
AppId={{B7C1D1E0-4A2F-4C8B-9E55-0D3A6F1C2A77}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppSupportURL}
AppUpdatesURL={#AppURL}
AppCopyright={#AppCopyright}
VersionInfoVersion={#AppVersion}
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} Setup
VersionInfoProductName={#AppName}
VersionInfoProductVersion={#AppVersion}
VersionInfoCopyright={#AppCopyright}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
AllowNoIcons=yes
UninstallDisplayIcon={app}\{#AppExe}
SetupIconFile=..\assets\icon.ico
OutputDir=..\dist
OutputBaseFilename=OpenDM-Setup-{#AppVersion}
LicenseFile=..\LICENSE
Compression=lzma2/ultra
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Per-user install by default: the browser host is registered under HKCU, which must be the real user's hive.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
CloseApplications=force
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Shortcuts:"
Name: "startup"; Description: "Start OpenDM with Windows (minimized to tray)"; GroupDescription: "Options:"; Flags: unchecked

[Files]
Source: "..\dist\OpenDM-windows.exe"; DestDir: "{app}"; DestName: "{#AppExe}"; Flags: ignoreversion
; ffmpeg next to the program: OpenDM looks there first (video + audio merging, HLS, DASH)
Source: "..\ffmpeg\ffmpeg.exe"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "..\extension\*"; DestDir: "{app}\extension"; Excludes: "manifest.firefox.json"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{group}\OpenDM browser extension folder"; Filename: "{app}\extension"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "OpenDM"; \
  ValueData: """{app}\{#AppExe}"" --minimized"; Flags: uninsdeletevalue; Tasks: startup

[Run]
; register the native-messaging host with every installed browser (Chrome/Edge/Brave/Firefox), then exit
Filename: "{app}\{#AppExe}"; Parameters: "--register-browsers"; Flags: runhidden waituntilterminated; StatusMsg: "Registering browser integration..."
Filename: "{app}\{#AppExe}"; Description: "Launch {#AppName}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{app}\{#AppExe}"; Parameters: "--unregister-browsers"; Flags: runhidden waituntilterminated; RunOnceId: "UnregBrowsers"

[Code]
procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then
    WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
      'Browser extension: open chrome://extensions (or edge://, brave://extensions), turn on Developer mode, ' +
      'click "Load unpacked" and select:' + #13#10 + ExpandConstant('{app}\extension');
end;
